@{
    ViewData["Title"] = L["Errors.ServerTitle"];
    ViewData["Description"] = L["Errors.ServerDescription"];
    ViewData["BodyClass"] = "page-error";
    ViewData["Robots"] = "noindex, nofollow";
}

<section class="error-page">
    <div class="container" style="max-width:560px;">
        <div class="error-code">500</div>
        <h1>@L["Errors.ServerHeading"]</h1>
        <p class="lead">@L["Errors.ServerLead"]</p>
        <div class="hero-actions" style="justify-content:center;">
            <a class="btn btn-primary" href="@SiteUrls.Page(SitePageKeys.Home)">@L["Common.BackHome"]</a>
            <a class="btn btn-ghost" href="@SiteUrls.Page(SitePageKeys.Contact)">@L["Common.Contact"]</a>
        </div>
    </div>
</section>
