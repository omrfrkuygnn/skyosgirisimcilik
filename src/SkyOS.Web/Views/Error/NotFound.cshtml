@{
    ViewData["Title"] = L["Errors.NotFoundTitle"];
    ViewData["Description"] = L["Errors.NotFoundDescription"];
    ViewData["BodyClass"] = "page-error page-not-found";
    ViewData["Robots"] = "noindex, nofollow";
}

<section class="error-hero" aria-labelledby="error-heading">
    <div class="error-hero-bg" aria-hidden="true">
        <div class="error-hero-grid"></div>
        <div class="error-hero-glow error-hero-glow--left"></div>
        <div class="error-hero-glow error-hero-glow--right"></div>
    </div>

    <div class="container error-hero-inner">
        <div class="error-visual" data-reveal="scale" aria-hidden="true">
            <svg class="error-visual-svg" viewBox="0 0 320 240" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="160" cy="120" r="96" stroke="currentColor" stroke-width="1.5" stroke-dasharray="6 8" opacity="0.35" />
                <circle cx="160" cy="120" r="64" stroke="currentColor" stroke-width="1.5" opacity="0.2" />
                <path d="M160 44 118 88h84L160 44Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                <path d="M160 196 118 152h84L160 196Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                <rect x="136" y="96" width="48" height="48" rx="10" stroke="currentColor" stroke-width="2" />
                <path d="M152 120h16M160 112v16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                <path d="M88 120h24M208 120h24M160 72v24M160 144v24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.5" />
            </svg>
            <span class="error-visual-badge">404</span>
        </div>

        <div class="error-copy" data-reveal>
            <span class="eyebrow">@L["Errors.NotFoundEyebrow"]</span>
            <p class="error-signal">@L["Errors.NotFoundSignal"]</p>
            <h1 id="error-heading">@L["Errors.NotFoundHeading"]</h1>
            <p class="lead error-lead">@L["Errors.NotFoundLead"]</p>

            <div class="hero-actions error-actions">
                <a class="btn btn-primary" href="@SiteUrls.Page(SitePageKeys.Home)">@L["Common.BackHome"]</a>
                <a class="btn btn-ghost" href="@SiteUrls.Page(SitePageKeys.Contact)">@L["Common.Contact"]</a>
            </div>
        </div>
    </div>
</section>

<section class="section error-suggestions-section">
    <div class="container">
        <div class="error-suggestions" data-reveal>
            <h2 class="error-suggestions-title">@L["Errors.NotFoundSuggestions"]</h2>
            <div class="error-suggestions-grid">
                <a class="error-suggestion-card" href="@SiteUrls.Page(SitePageKeys.About)">
                    <span class="error-suggestion-icon" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8"/><path d="M5 20c1.2-3.3 4-5 7-5s5.8 1.7 7 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    </span>
                    <span class="error-suggestion-label">@L["Nav.About"]</span>
                </a>
                <a class="error-suggestion-card" href="@SiteUrls.Page(SitePageKeys.Product)">
                    <span class="error-suggestion-icon" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="4" y="6" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M8 10h8M8 14h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    </span>
                    <span class="error-suggestion-label">@L["Nav.Product"]</span>
                </a>
                <a class="error-suggestion-card" href="@SiteUrls.Page(SitePageKeys.Achievements)">
                    <span class="error-suggestion-icon" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M8 21h8M12 17V9M7 4h10l1 5H6l1-5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                    </span>
                    <span class="error-suggestion-label">@L["Nav.Achievements"]</span>
                </a>
                <a class="error-suggestion-card" href="@SiteUrls.Page(SitePageKeys.Contact)">
                    <span class="error-suggestion-icon" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 6h16v12H4V6Z" stroke="currentColor" stroke-width="1.8"/><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                    </span>
                    <span class="error-suggestion-label">@L["Nav.Contact"]</span>
                </a>
            </div>
        </div>
    </div>
</section>
