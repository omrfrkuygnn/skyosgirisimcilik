@{
    ViewData["Title"] = L["Product.Title"];
    ViewData["Description"] = L["Product.Description"];
}

<section class="page-intro">
    <div class="container">
        <div class="section-head mb-0" data-reveal>
            <span class="eyebrow">@L["Product.Eyebrow"]</span>
            <h1>@L["Product.Heading"]</h1>
            <p class="lead">@L["Product.Lead"]</p>
        </div>
    </div>
</section>

<section class="section" style="padding-top:0;">
    <div class="container">
        <div class="sector-grid" style="margin-bottom:clamp(40px,5vw,56px);">
            <article class="sector-tile" data-reveal>
                <span class="card-kicker">@L["Product.KickerSecurity"]</span>
                <h3>@L["Product.Feature1Title"]</h3>
                <p>@L["Product.Feature1Text"]</p>
            </article>
            <article class="sector-tile" data-reveal>
                <span class="card-kicker">@L["Product.KickerOps"]</span>
                <h3>@L["Product.Feature2Title"]</h3>
                <p>@L["Product.Feature2Text"]</p>
            </article>
            <article class="sector-tile" data-reveal>
                <span class="card-kicker">@L["Product.KickerCoord"]</span>
                <h3>@L["Product.Feature3Title"]</h3>
                <p>@L["Product.Feature3Text"]</p>
            </article>
            <article class="sector-tile" data-reveal>
                <span class="card-kicker">@L["Product.KickerAutonomy"]</span>
                <h3>@L["Product.Feature4Title"]</h3>
                <p>@L["Product.Feature4Text"]</p>
            </article>
        </div>

        <article class="feature-strip" data-reveal>
            <div class="feature-strip-media">
                <img src="~/img/banners/banner-combat.webp" width="720" height="480" alt="" loading="lazy" decoding="async" asp-append-version="true" />
            </div>
            <div class="feature-strip-body">
                <span class="eyebrow mb-0">@L["Product.StatusEyebrow"]</span>
                <h2>@L["Product.StatusTitle"]</h2>
                <p>@L["Product.StatusLead"]</p>
            </div>
        </article>

        <div class="timeline-block" data-reveal>
            <ul class="roadmap-list">
                <li class="roadmap-row"><span>@L["Product.Row1"]</span><span class="pill pill-done">@L["Product.Done"]</span></li>
                <li class="roadmap-row"><span>@L["Product.Row2"]</span><span class="pill pill-done">@L["Product.Done"]</span></li>
                <li class="roadmap-row"><span>@L["Product.Row3"]</span><span class="pill pill-done">@L["Product.Done"]</span></li>
                <li class="roadmap-row"><span>@L["Product.Row4"]</span><span class="pill pill-done">@L["Product.Done"]</span></li>
                <li class="roadmap-row"><span>@L["Product.Row5"]</span><span class="pill pill-done">@L["Product.Done"]</span></li>
                <li class="roadmap-row"><span>@L["Product.Row6"]</span><span class="pill pill-done">@L["Product.Done"]</span></li>
                <li class="roadmap-row"><span>@L["Product.Row7"]</span><span class="pill pill-done">@L["Product.Done"]</span></li>
                <li class="roadmap-row"><span>@L["Product.Row8"]</span><span class="pill pill-done">@L["Product.Done"]</span></li>
                <li class="roadmap-row"><span>@L["Product.Row9"]</span><span class="pill pill-progress">@L["Product.InProgress"]</span></li>
            </ul>
            <p class="form-note" style="margin-top:16px;">@L["Product.Note"]</p>
        </div>
    </div>
</section>
