@{
    ViewData["Title"] = L["Product.Title"];
    ViewData["Description"] = L["Product.Description"];
    ViewData["BodyClass"] = "page-product";
}

<section class="page-intro page-banner">
    <partial name="_PageBannerMedia" model='"~/img/banners/page-product.webp"' />
    <div class="container">
        <div class="section-head mb-0" data-reveal>
            <span class="eyebrow">@L["Product.Eyebrow"]</span>
            <h1>@L["Product.Heading"]</h1>
            <p class="lead">@L["Product.Lead"]</p>
        </div>
    </div>
</section>

<section class="section" style="padding-top:0;">
    <div class="container">
        <div class="sector-grid sector-grid--2 product-feature-grid">
            <article class="sector-tile" data-reveal>
                <span class="card-kicker">@L["Product.KickerSecurity"]</span>
                <h3>@L["Product.Feature1Title"]</h3>
                <p>@L["Product.Feature1Text"]</p>
            </article>
            <article class="sector-tile" data-reveal>
                <span class="card-kicker">@L["Product.KickerOps"]</span>
                <h3>@L["Product.Feature2Title"]</h3>
                <p>@L["Product.Feature2Text"]</p>
            </article>
            <article class="sector-tile" data-reveal>
                <span class="card-kicker">@L["Product.KickerCoord"]</span>
                <h3>@L["Product.Feature3Title"]</h3>
                <p>@L["Product.Feature3Text"]</p>
            </article>
            <article class="sector-tile" data-reveal>
                <span class="card-kicker">@L["Product.KickerAutonomy"]</span>
                <h3>@L["Product.Feature4Title"]</h3>
                <p>@L["Product.Feature4Text"]</p>
            </article>
        </div>

        <article class="feature-strip" data-reveal>
            <div class="feature-strip-media">
                <img src="~/img/banners/banner-combat.webp" width="720" height="480" alt="" loading="lazy" decoding="async" asp-append-version="true" />
            </div>
            <div class="feature-strip-body">
                <span class="eyebrow mb-0">@L["Product.StatusEyebrow"]</span>
                <h2>@L["Product.StatusTitle"]</h2>
                <p>@L["Product.StatusLead"]</p>
            </div>
        </article>

        <div class="product-roadmap" data-reveal>
            <div class="product-roadmap-head">
                <div class="product-roadmap-progress" role="group" aria-label="@L["Product.ProgressLabel"]">
                    <div class="product-roadmap-progress-bar" aria-hidden="true">
                        <span style="width:88.89%"></span>
                    </div>
                    <p class="product-roadmap-progress-meta">
                        <strong>8 / 9</strong>
                        <span>@L["Product.ProgressLabel"]</span>
                    </p>
                </div>
            </div>

            <ol class="product-roadmap-list">
                <li class="product-roadmap-item product-roadmap-item--done">
                    <span class="product-roadmap-index" aria-hidden="true">01</span>
                    <div class="product-roadmap-body">
                        <span class="product-roadmap-title">@L["Product.Row1"]</span>
                        <span class="pill pill-done">@L["Product.Done"]</span>
                    </div>
                </li>
                <li class="product-roadmap-item product-roadmap-item--done">
                    <span class="product-roadmap-index" aria-hidden="true">02</span>
                    <div class="product-roadmap-body">
                        <span class="product-roadmap-title">@L["Product.Row2"]</span>
                        <span class="pill pill-done">@L["Product.Done"]</span>
                    </div>
                </li>
                <li class="product-roadmap-item product-roadmap-item--done">
                    <span class="product-roadmap-index" aria-hidden="true">03</span>
                    <div class="product-roadmap-body">
                        <span class="product-roadmap-title">@L["Product.Row3"]</span>
                        <span class="pill pill-done">@L["Product.Done"]</span>
                    </div>
                </li>
                <li class="product-roadmap-item product-roadmap-item--done">
                    <span class="product-roadmap-index" aria-hidden="true">04</span>
                    <div class="product-roadmap-body">
                        <span class="product-roadmap-title">@L["Product.Row4"]</span>
                        <span class="pill pill-done">@L["Product.Done"]</span>
                    </div>
                </li>
                <li class="product-roadmap-item product-roadmap-item--done">
                    <span class="product-roadmap-index" aria-hidden="true">05</span>
                    <div class="product-roadmap-body">
                        <span class="product-roadmap-title">@L["Product.Row5"]</span>
                        <span class="pill pill-done">@L["Product.Done"]</span>
                    </div>
                </li>
                <li class="product-roadmap-item product-roadmap-item--done">
                    <span class="product-roadmap-index" aria-hidden="true">06</span>
                    <div class="product-roadmap-body">
                        <span class="product-roadmap-title">@L["Product.Row6"]</span>
                        <span class="pill pill-done">@L["Product.Done"]</span>
                    </div>
                </li>
                <li class="product-roadmap-item product-roadmap-item--done">
                    <span class="product-roadmap-index" aria-hidden="true">07</span>
                    <div class="product-roadmap-body">
                        <span class="product-roadmap-title">@L["Product.Row7"]</span>
                        <span class="pill pill-done">@L["Product.Done"]</span>
                    </div>
                </li>
                <li class="product-roadmap-item product-roadmap-item--done">
                    <span class="product-roadmap-index" aria-hidden="true">08</span>
                    <div class="product-roadmap-body">
                        <span class="product-roadmap-title">@L["Product.Row8"]</span>
                        <span class="pill pill-done">@L["Product.Done"]</span>
                    </div>
                </li>
                <li class="product-roadmap-item product-roadmap-item--active">
                    <span class="product-roadmap-index" aria-hidden="true">09</span>
                    <div class="product-roadmap-body">
                        <span class="product-roadmap-title">@L["Product.Row9"]</span>
                        <span class="pill pill-progress">@L["Product.InProgress"]</span>
                    </div>
                </li>
            </ol>
            <p class="product-roadmap-note">@L["Product.Note"]</p>
        </div>
    </div>
</section>
