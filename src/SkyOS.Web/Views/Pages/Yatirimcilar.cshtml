@{
    ViewData["Title"] = L["Investors.Title"];
    ViewData["Description"] = L["Investors.Description"];
    ViewData["BodyClass"] = "page-investors";
}

<section class="page-intro page-banner">
    <partial name="_PageBannerMedia" model='"~/img/banners/page-investors.webp"' />
    <div class="container">
        <div class="section-head mb-0" data-reveal>
            <span class="eyebrow">@L["Investors.Eyebrow"]</span>
            <h1>@L["Investors.Heading"]</h1>
            <p class="lead">@L["Investors.Lead"]</p>
        </div>
    </div>
</section>

<section class="section section-tight investors-section investors-section--priorities">
    <div class="container">
        <div class="investors-priorities-grid" data-reveal>
            <div class="investors-priorities">
                <div class="timeline-head investors-block-head">
                    <span class="eyebrow mb-0">@L["Investors.PriorityEyebrow"]</span>
                    <h2>@L["Investors.PriorityTitle"]</h2>
                </div>
                <ol class="timeline-list investors-priority-list">
                    <li class="timeline-item">
                        <span class="timeline-marker" aria-hidden="true"></span>
                        <div class="timeline-card investors-priority-card investors-priority-card--primary">
                            <h3>@L["Investors.Priority1"]</h3>
                            <p>@L["Investors.Priority1Note"]</p>
                        </div>
                    </li>
                    <li class="timeline-item">
                        <span class="timeline-marker" aria-hidden="true"></span>
                        <div class="timeline-card investors-priority-card">
                            <h3>@L["Investors.Priority2"]</h3>
                        </div>
                    </li>
                    <li class="timeline-item">
                        <span class="timeline-marker" aria-hidden="true"></span>
                        <div class="timeline-card investors-priority-card">
                            <h3>@L["Investors.Priority3"]</h3>
                        </div>
                    </li>
                    <li class="timeline-item">
                        <span class="timeline-marker" aria-hidden="true"></span>
                        <div class="timeline-card investors-priority-card investors-priority-card--secondary">
                            <h3>@L["Investors.Priority4"]</h3>
                            <p>@L["Investors.Priority4Note"]</p>
                        </div>
                    </li>
                </ol>
            </div>
            <figure class="investors-priorities-media">
                <img src="~/img/banners/investors-priorities.webp" width="960" height="720" alt="@L["Investors.PriorityAlt"]" loading="lazy" decoding="async" asp-append-version="true" />
            </figure>
        </div>
    </div>
</section>

<section class="section section-tight section-alt investors-section investors-section--impact">
    <div class="container">
        <div class="section-head investors-block-head" data-reveal>
            <span class="eyebrow">@L["Investors.ImpactEyebrow"]</span>
            <h2>@L["Investors.ImpactTitle"]</h2>
        </div>
        <div class="investors-impact-panel" data-reveal>
            <div class="investors-impact-cols" aria-hidden="true">
                <span>@L["Investors.ColArea"]</span>
                <span>@L["Investors.ColEffect"]</span>
            </div>
            <ul class="roadmap-list investors-impact-list">
                <li class="roadmap-row"><span>@L["Investors.Row1Area"]</span><span class="muted">@L["Investors.Row1Effect"]</span></li>
                <li class="roadmap-row"><span>@L["Investors.Row2Area"]</span><span class="muted">@L["Investors.Row2Effect"]</span></li>
                <li class="roadmap-row"><span>@L["Investors.Row3Area"]</span><span class="muted">@L["Investors.Row3Effect"]</span></li>
                <li class="roadmap-row"><span>@L["Investors.Row4Area"]</span><span class="muted">@L["Investors.Row4Effect"]</span></li>
                <li class="roadmap-row"><span>@L["Investors.Row5Area"]</span><span class="muted">@L["Investors.Row5Effect"]</span></li>
            </ul>
        </div>
    </div>
</section>

<section class="section section-tight investors-section investors-section--markets">
    <div class="container">
        <div class="sector-grid investors-market-grid">
            <article class="sector-tile investors-market-tile" data-reveal>
                <span class="card-kicker">@L["Investors.MarketKicker"]</span>
                <h3>@L["Investors.Market1Title"]</h3>
                <p>@L["Investors.Market1Text"]</p>
            </article>
            <article class="sector-tile investors-market-tile" data-reveal>
                <span class="card-kicker">@L["Investors.MarketKicker"]</span>
                <h3>@L["Investors.Market2Title"]</h3>
                <p>@L["Investors.Market2Text"]</p>
            </article>
            <article class="sector-tile investors-market-tile" data-reveal>
                <span class="card-kicker">@L["Investors.MarketKicker"]</span>
                <h3>@L["Investors.Market3Title"]</h3>
                <p>@L["Investors.Market3Text"]</p>
            </article>
        </div>
    </div>
</section>

<section class="section section-tight investors-section investors-section--cta">
    <div class="container">
        <article class="feature-strip investors-cta" data-reveal>
            <div class="feature-strip-media investors-cta-media">
                <img src="~/img/banners/banner-swarm.webp" width="720" height="480" alt="" loading="lazy" decoding="async" asp-append-version="true" />
                <div class="investors-cta-scrim" aria-hidden="true"></div>
            </div>
            <div class="feature-strip-body investors-cta-body">
                <span class="eyebrow mb-0">@L["Investors.Eyebrow"]</span>
                <h2>@L["Investors.CtaTitle"]</h2>
                <p>@L["Investors.CtaLead"]</p>
                <div class="hero-actions">
                    <a class="btn btn-primary" href="@SiteUrls.Page(SitePageKeys.Contact, queryValues: new { ilgi = "yatirimci" })">@L["Investors.CtaButton"]</a>
                </div>
            </div>
        </article>
    </div>
</section>
