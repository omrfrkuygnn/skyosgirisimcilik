@model TeamPageViewModel
@{
    ViewData["Title"] = L["Team.Title"];
    ViewData["Description"] = L["Team.Description"];

    static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 0 ? "?" : string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }

    var profileMembers = Model.Leaders.Concat(Model.Members)
        .Where(m => !string.IsNullOrWhiteSpace(m.Bio))
        .ToList();
}

<section class="page-intro page-banner">
    <partial name="_PageBannerMedia" model='"~/img/banners/page-team.webp"' />
    <div class="container">
        <div class="section-head mb-0" data-reveal>
            <span class="eyebrow">@L["Team.Eyebrow"]</span>
            <h1>@L["Team.Heading"]</h1>
            <p class="lead">@L["Team.Lead", Model.CurrentHeadcount, Model.TargetHeadcountLow, Model.TargetHeadcountHigh]</p>
        </div>
    </div>
</section>

<section class="section" style="padding-top:0;">
    <div class="container">
        <div class="section-head" data-reveal>
            <h2>@L["Team.LeadersHeading"]</h2>
        </div>
        <div class="member-grid member-grid--leaders" style="margin-bottom:clamp(40px,5vw,56px);">
            @foreach (var leader in Model.Leaders)
            {
                var hasBio = !string.IsNullOrWhiteSpace(leader.Bio);
                <article class="member-card member-card--leader@(hasBio ? " member-card--interactive" : "")" data-reveal>
                    <div class="member-card__media">
                        @if (!string.IsNullOrWhiteSpace(leader.PhotoUrl))
                        {
                            <img class="member-photo" src="@leader.PhotoUrl" width="112" height="112" loading="lazy" decoding="async" alt="@leader.FullName" />
                        }
                        else
                        {
                            <div class="member-photo member-photo-fallback" aria-hidden="true">@Initials(leader.FullName)</div>
                        }
                    </div>
                    <div class="member-card__body">
                        <h3 class="member-card__name">@leader.FullName</h3>
                        <div class="member-role">@leader.Role</div>
                        <span class="leader-tag">@L["Common.LeaderTag"]</span>
                        @if (hasBio)
                        {
                            <button type="button"
                                    class="member-card__cta"
                                    data-member-open
                                    data-member-target="member-@leader.Id"
                                    aria-haspopup="dialog">
                                @L["Team.ViewProfile"]
                            </button>
                        }
                    </div>
                </article>
            }
        </div>

        @if (Model.Members.Count > 0)
        {
            <div class="section-head" data-reveal>
                <h2>@L["Team.MembersHeading"]</h2>
            </div>
            <div class="member-grid">
                @foreach (var member in Model.Members)
                {
                    var hasBio = !string.IsNullOrWhiteSpace(member.Bio);
                    <article class="member-card@(hasBio ? " member-card--interactive" : "")" data-reveal>
                        <div class="member-card__media">
                            @if (!string.IsNullOrWhiteSpace(member.PhotoUrl))
                            {
                                <img class="member-photo" src="@member.PhotoUrl" width="96" height="96" loading="lazy" decoding="async" alt="@member.FullName" />
                            }
                            else
                            {
                                <div class="member-photo member-photo-fallback" aria-hidden="true">@Initials(member.FullName)</div>
                            }
                        </div>
                        <div class="member-card__body">
                            <h3 class="member-card__name">@member.FullName</h3>
                            <div class="member-role">@member.Role</div>
                            @if (hasBio)
                            {
                                <button type="button"
                                        class="member-card__cta"
                                        data-member-open
                                        data-member-target="member-@member.Id"
                                        aria-haspopup="dialog">
                                    @L["Team.ViewProfile"]
                                </button>
                            }
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="empty-state" data-reveal>
                <p class="mb-0">@L["Team.Empty"]</p>
            </div>
        }
    </div>
</section>

@foreach (var person in profileMembers)
{
    <dialog class="member-dialog" id="member-@person.Id" aria-labelledby="member-@person.Id-title">
        <div class="member-dialog__panel">
            <button type="button" class="member-dialog__close" data-member-close aria-label="@L["Team.CloseProfile"]">
                <span aria-hidden="true">&times;</span>
            </button>
            <div class="member-dialog__head">
                @if (!string.IsNullOrWhiteSpace(person.PhotoUrl))
                {
                    <img class="member-dialog__photo" src="@person.PhotoUrl" width="120" height="120" alt="" />
                }
                else
                {
                    <div class="member-dialog__photo member-photo-fallback" aria-hidden="true">@Initials(person.FullName)</div>
                }
                <div class="member-dialog__identity">
                    <h2 class="member-dialog__name" id="member-@person.Id-title">@person.FullName</h2>
                    <div class="member-role">@person.Role</div>
                    @if (person.IsLeader)
                    {
                        <span class="leader-tag">@L["Common.LeaderTag"]</span>
                    }
                </div>
            </div>
            <div class="member-dialog__bio">
                <p>@person.Bio</p>
            </div>
        </div>
    </dialog>
}
