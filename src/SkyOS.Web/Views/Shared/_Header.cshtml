@{
    string Active(params string[] pageKeys) => SiteUrls.IsCurrentPage(Context, pageKeys) ? "active" : string.Empty;
    var isHome = SiteUrls.IsCurrentPage(SitePageKeys.Home, Context);
    var culture = L.Culture;
    var trSwitchUrl = $"/dil/tr?returnUrl={Uri.EscapeDataString(SiteUrls.CurrentPageInCulture("tr", Context))}";
    var enSwitchUrl = $"/dil/en?returnUrl={Uri.EscapeDataString(SiteUrls.CurrentPageInCulture("en", Context))}";
    var deSwitchUrl = $"/dil/de?returnUrl={Uri.EscapeDataString(SiteUrls.CurrentPageInCulture("de", Context))}";
}
<header class="site-header@(isHome ? " site-header--overlay" : string.Empty)" data-header>
    <div class="header-shell header-inner">
        <a class="brand" href="@SiteUrls.Page(SitePageKeys.Home)" aria-label="@L["Nav.BrandHome"]">
            <svg class="brand-mark" width="34" height="34" viewBox="0 0 48 48" fill="none" aria-hidden="true" focusable="false">
                <path d="M24 3 6 13v22l18 10 18-10V13L24 3Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
                <path d="M24 14v20M15 19l18 10M33 19 15 29" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
            <span class="brand-text">Sky<span class="brand-accent">OS</span></span>
        </a>

        <button class="nav-toggle" type="button" aria-label="@L["Nav.Toggle"]" aria-expanded="false" aria-controls="primary-nav" data-nav-toggle>
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
        </button>

        <nav id="primary-nav" class="site-nav" aria-label="@L["Nav.Primary"]" data-nav>
            <ul class="nav-list">
                <li><a class="nav-link @Active(SitePageKeys.Product)" href="@SiteUrls.Page(SitePageKeys.Product)">@L["Nav.Product"]</a></li>
                <li><a class="nav-link @Active(SitePageKeys.UseCases)" href="@SiteUrls.Page(SitePageKeys.UseCases)">@L["Nav.UseCases"]</a></li>
                <li><a class="nav-link @Active(SitePageKeys.Achievements)" href="@SiteUrls.Page(SitePageKeys.Achievements)">@L["Nav.Achievements"]</a></li>
                <li><a class="nav-link @Active(SitePageKeys.Partners)" href="@SiteUrls.Page(SitePageKeys.Partners)">@L["Nav.Partners"]</a></li>
                <li><a class="nav-link @Active(SitePageKeys.About)" href="@SiteUrls.Page(SitePageKeys.About)">@L["Nav.About"]</a></li>
                <li><a class="nav-link @Active(SitePageKeys.Team)" href="@SiteUrls.Page(SitePageKeys.Team)">@L["Nav.Team"]</a></li>
                <li><a class="nav-link @Active(SitePageKeys.Investors)" href="@SiteUrls.Page(SitePageKeys.Investors)">@L["Nav.Investors"]</a></li>
                <li><a class="nav-link @Active(SitePageKeys.News)" href="@SiteUrls.Page(SitePageKeys.News)">@L["Nav.News"]</a></li>
                <li><a class="nav-link @Active(SitePageKeys.Contact, SitePageKeys.ContactSuccess)" href="@SiteUrls.Page(SitePageKeys.Contact)">@L["Nav.Contact"]</a></li>
            </ul>
        </nav>

        <div class="lang-dropdown" data-lang-dropdown>
            <button class="lang-dropdown-btn" type="button" aria-expanded="false" aria-label="@L["Nav.LangSwitch"]" data-lang-btn>
                @if (culture == "en")
                {
                    <svg class="lang-flag-icon" viewBox="0 0 640 480" width="18" height="13.5" aria-hidden="true"><clipPath id="gb-hdr-s"><path d="M0,0 v480 h640 v-480 z"/></clipPath><clipPath id="gb-hdr-t"><path d="M0,0 L640,480 M640,0 L0,480"/></clipPath><g clip-path="url(#gb-hdr-s)"><path d="M0,0 v480 h640 v-480 z" fill="#012169"/><path d="M0,0 L640,480 M640,0 L0,480" stroke="#fff" stroke-width="60"/><path d="M0,0 L640,480 M640,0 L0,480" clip-path="url(#gb-hdr-t)" stroke="#C8102E" stroke-width="40"/><path d="M320,0 v480 M0,240 h640" stroke="#fff" stroke-width="100"/><path d="M320,0 v480 M0,240 h640" stroke="#C8102E" stroke-width="60"/></g></svg>
                    <span class="lang-code">EN</span>
                }
                else if (culture == "de")
                {
                    <svg class="lang-flag-icon" viewBox="0 0 640 480" width="18" height="13.5" aria-hidden="true"><rect width="640" height="160" y="0" fill="#000000"/><rect width="640" height="160" y="160" fill="#DD0000"/><rect width="640" height="160" y="320" fill="#FFCE00"/></svg>
                    <span class="lang-code">DE</span>
                }
                else
                {
                    <svg class="lang-flag-icon" viewBox="0 0 640 480" width="18" height="13.5" aria-hidden="true"><rect width="640" height="480" fill="#e30a17"/><circle cx="270" cy="240" r="144" fill="#ffffff"/><circle cx="300" cy="240" r="115.2" fill="#e30a17"/><polygon fill="#ffffff" points="345.6,240 432,268 384,196.8 384,283.2 432,212"/></svg>
                    <span class="lang-code">TR</span>
                }
                <svg class="lang-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="lang-dropdown-menu" role="menu">
                <a class="lang-dropdown-item@(culture == "tr" ? " is-active" : "")" href="@trSwitchUrl" hreflang="tr" lang="tr" role="menuitem">
                    <svg class="lang-flag-icon" viewBox="0 0 640 480" width="18" height="13.5" aria-hidden="true"><rect width="640" height="480" fill="#e30a17"/><circle cx="270" cy="240" r="144" fill="#ffffff"/><circle cx="300" cy="240" r="115.2" fill="#e30a17"/><polygon fill="#ffffff" points="345.6,240 432,268 384,196.8 384,283.2 432,212"/></svg>
                    <span class="lang-item-name">Türkçe</span>
                    <span class="lang-item-code">TR</span>
                </a>
                <a class="lang-dropdown-item@(culture == "en" ? " is-active" : "")" href="@enSwitchUrl" hreflang="en" lang="en" role="menuitem">
                    <svg class="lang-flag-icon" viewBox="0 0 640 480" width="18" height="13.5" aria-hidden="true"><clipPath id="gb-mnu-s"><path d="M0,0 v480 h640 v-480 z"/></clipPath><clipPath id="gb-mnu-t"><path d="M0,0 L640,480 M640,0 L0,480"/></clipPath><g clip-path="url(#gb-mnu-s)"><path d="M0,0 v480 h640 v-480 z" fill="#012169"/><path d="M0,0 L640,480 M640,0 L0,480" stroke="#fff" stroke-width="60"/><path d="M0,0 L640,480 M640,0 L0,480" clip-path="url(#gb-mnu-t)" stroke="#C8102E" stroke-width="40"/><path d="M320,0 v480 M0,240 h640" stroke="#fff" stroke-width="100"/><path d="M320,0 v480 M0,240 h640" stroke="#C8102E" stroke-width="60"/></g></svg>
                    <span class="lang-item-name">English</span>
                    <span class="lang-item-code">EN</span>
                </a>
                <a class="lang-dropdown-item@(culture == "de" ? " is-active" : "")" href="@deSwitchUrl" hreflang="de" lang="de" role="menuitem">
                    <svg class="lang-flag-icon" viewBox="0 0 640 480" width="18" height="13.5" aria-hidden="true"><rect width="640" height="160" y="0" fill="#000000"/><rect width="640" height="160" y="160" fill="#DD0000"/><rect width="640" height="160" y="320" fill="#FFCE00"/></svg>
                    <span class="lang-item-name">Deutsch</span>
                    <span class="lang-item-code">DE</span>
                </a>
            </div>
        </div>
    </div>
</header>
