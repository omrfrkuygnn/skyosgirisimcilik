@inject IOptions<SiteContactOptions> SiteContact
@inject IWebHostEnvironment HostEnvironment
@{
    var nonce = Context.GetCspNonce();
    var title = ViewData["Title"] as string;
    var fullTitle = string.IsNullOrEmpty(title) ? L["Layout.DefaultTitle"] : L["Layout.TitleSuffix", title];
    var description = ViewData["Description"] as string ?? L["Layout.DefaultDescription"];
    var ogLocale = L["Layout.OgLocale"];
    var currentPageKey = SiteUrls.GetCurrentPageKey(Context);
    var canonicalUrl = currentPageKey is null ? null : SiteUrls.AbsolutePage(Context, currentPageKey, queryValues: Context.Request.Query);
    var alternateUrls = currentPageKey is null
        ? Array.Empty<(string Culture, string Url)>()
        : SiteUrls.GetAlternateAbsoluteUrls(Context);
    var robots = ViewData["Robots"] as string ?? "index, follow";
    var isDev = HostEnvironment.IsDevelopment();
}
<!DOCTYPE html>
<html lang="@L.Culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@fullTitle</title>
    <meta name="description" content="@description" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content="@robots" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="@ogLocale" />
    @if (!string.IsNullOrWhiteSpace(canonicalUrl))
    {
        <link rel="canonical" href="@canonicalUrl" />
        @foreach (var alternate in alternateUrls)
        {
            <link rel="alternate" hreflang="@alternate.Culture" href="@alternate.Url" />
        }
    }
    <link rel="icon" href="~/favicon.ico" />
    <link rel="preload" href="~/fonts/ibm-plex-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/ibm-plex-sans-400-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/ibm-plex-sans-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/jetbrains-mono-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/syne-latin-800.woff2" as="font" type="font/woff2" crossorigin />
    @* Development: load site.v3.css directly so style edits show without WebOptimizer cache *@
    @if (isDev)
    {
        <link rel="stylesheet" href="~/css/site.v3.css" asp-append-version="true" />
    }
    else
    {
        <link rel="preload" href="~/css/site.min.css" as="style" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />
    }
</head>
<body class="@(ViewData["BodyClass"] as string)">
    <a class="skip-link" href="#main">@L["Layout.SkipLink"]</a>
    <partial name="_Header" />

    <main id="main">
        @RenderBody()
    </main>

    <partial name="_Footer" />

    <button type="button"
            class="back-to-top"
            data-back-to-top
            aria-label="@L["Layout.BackToTop"]"
            aria-hidden="true"
            tabindex="-1">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M12 5v14M5 12l7-7 7 7" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/js/site.min.js" defer asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
