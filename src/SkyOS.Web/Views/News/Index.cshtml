@model IReadOnlyList<SkyOS.Application.DTOs.News.NewsListItemDto>
@{
    ViewData["Title"] = L["News.Title"];
    ViewData["Description"] = L["News.Description"];
}

<section class="page-intro page-banner">
    <partial name="_PageBannerMedia" model='"~/img/banners/page-news.webp"' />
    <div class="container">
        <div class="section-head mb-0" data-reveal>
            <span class="eyebrow">@L["News.Eyebrow"]</span>
            <h1>@L["News.Heading"]</h1>
            <p class="lead">@L["News.Lead"]</p>
        </div>
    </div>
</section>

<section class="section" style="padding-top:0;">
    <div class="container">
        @if (Model.Count == 0)
        {
            <p class="lead">@L["News.Empty"]</p>
        }
        else
        {
            <div class="news-grid">
                @foreach (var item in Model)
                {
                    <article class="news-card" data-reveal>
                        <time class="news-date" datetime="@item.PublishedAtUtc.ToString("yyyy-MM-dd")">
                            @item.PublishedAtUtc.ToLocalTime().ToString("d")
                        </time>
                        <h2 class="news-title">
                            <a href="@SiteUrls.NewsArticle(item.Slug)">@item.Title</a>
                        </h2>
                        <p class="news-summary">@item.Summary</p>
                        <a class="text-link" href="@SiteUrls.NewsArticle(item.Slug)">@L["News.ReadMore"]</a>
                    </article>
                }
            </div>
        }
    </div>
</section>
