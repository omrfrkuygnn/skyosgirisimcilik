@model PartnersPageViewModel
@{
    ViewData["Title"] = L["Partners.Title"];
    ViewData["Description"] = L["Partners.Description"];

    static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 0 ? "?" : parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
    }

    static string? ResolveLogo(PartnerDto partner)
    {
        if (!string.IsNullOrWhiteSpace(partner.LogoUrl))
        {
            return partner.LogoUrl;
        }

        return partner.Name.Contains("HAVELSAN", StringComparison.OrdinalIgnoreCase)
            ? "/img/partners/havelsan.svg"
            : partner.Name.Contains("TEKNOFEST", StringComparison.OrdinalIgnoreCase)
                ? "/img/partners/teknofest.png"
                : null;
    }
}

<section class="page-intro page-intro--partners page-intro--compact page-banner">
    <partial name="_PageBannerMedia" model='"~/img/banners/page-partners.webp"' />
    <div class="container">
        <div class="section-head mb-0" data-reveal>
            <span class="eyebrow">@L["Partners.Eyebrow"]</span>
            <h1>@L["Partners.Heading"]</h1>
            <p class="lead">@L["Partners.Lead"]</p>
        </div>
    </div>
</section>

<section class="section section-tight" style="padding-top:0;">
    <div class="container partners-page">
        @if (Model.VerifiedPartners.Count > 0)
        {
            <div class="partner-feature-list">
                @foreach (var partner in Model.VerifiedPartners)
                {
                    var logo = ResolveLogo(partner);
                    var isHavelsan = partner.Name.Contains("HAVELSAN", StringComparison.OrdinalIgnoreCase);
                    <article class="partner-feature@(isHavelsan ? " partner-feature--havelsan" : "")" data-reveal>
                        <div class="partner-feature-visual">
                            @if (logo is not null)
                            {
                                <img src="@logo" width="200" height="64" alt="@L["Partners.LogoAlt", partner.Name]" loading="lazy" asp-append-version="true" />
                            }
                            else
                            {
                                <span class="partner-logo" aria-hidden="true">@Initials(partner.Name)</span>
                            }
                        </div>
                        <div class="partner-feature-body">
                            <span class="verified-tag">@L["Partners.VerifiedTag"]</span>
                            <h2>@partner.Name</h2>
                            @if (!string.IsNullOrWhiteSpace(partner.Description))
                            {
                                <p>@partner.Description</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(partner.Address) || !string.IsNullOrWhiteSpace(partner.Phone))
                            {
                                <div class="partner-contact-details">
                                    @if (!string.IsNullOrWhiteSpace(partner.Address))
                                    {
                                        <div class="partner-detail-item">
                                            <span class="detail-icon" aria-hidden="true">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                            </span>
                                            <span><strong>@L["Partners.Address"]:</strong> @partner.Address</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(partner.Phone))
                                    {
                                        <div class="partner-detail-item">
                                            <span class="detail-icon" aria-hidden="true">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                                            </span>
                                            <span><strong>@L["Partners.Phone"]:</strong> <a href="tel:@partner.Phone.Replace(" ", string.Empty).Replace("(", string.Empty).Replace(")", string.Empty)">@partner.Phone</a></span>
                                        </div>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(partner.WebsiteUrl) || !string.IsNullOrWhiteSpace(partner.SupportLetterUrl))
                            {
                                <div class="partner-actions" style="display:flex; gap:12px; flex-wrap:wrap; margin-top:16px;">
                                    @if (!string.IsNullOrWhiteSpace(partner.SupportLetterUrl))
                                    {
                                        <a class="btn btn-primary btn-sm support-letter-btn" href="@partner.SupportLetterUrl" target="_blank" rel="noopener noreferrer">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                                            @L["Partners.ViewSupportLetter"]
                                        </a>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(partner.WebsiteUrl))
                                    {
                                        <a class="btn btn-ghost btn-sm" href="@partner.WebsiteUrl" rel="noopener noreferrer" target="_blank">@L["Common.Website"]</a>
                                    }
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>
        }

        <article class="feature-strip feature-strip--amber feature-strip--compact" data-reveal>
            <div class="feature-strip-media">
                <img src="~/img/banners/banner-swarm.webp" width="720" height="480" alt="" loading="lazy" decoding="async" asp-append-version="true" />
            </div>
            <div class="feature-strip-body">
                <span class="eyebrow mb-0">@L["Partners.FieldTag"]</span>
                <h2>@L["Partners.FieldTitle"]</h2>
                <p>@L["Partners.FieldText"]</p>
                <div class="hero-actions" style="margin-top:4px;">
                    <a class="btn btn-primary" href="@SiteUrls.Page(SitePageKeys.Achievements)">@L["Partners.FieldCta"]</a>
                </div>
            </div>
        </article>

        <div class="support-letters-section" style="margin-top: 64px;" data-reveal>
            <div class="section-head mb-4">
                <span class="eyebrow">@L["Partners.SupportLettersEyebrow"]</span>
                <h2>@L["Partners.SupportLettersHeading"]</h2>
                <p class="lead" style="max-width:680px; margin:0;">@L["Partners.SupportLettersLead"]</p>
            </div>
            <div class="support-letters-grid" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap:24px; margin-top:32px;">
                <div class="support-letter-card">
                    <div class="support-card-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                        <img src="~/img/partners/harven-logo.png" style="height:38px; width:auto; object-fit:contain;" alt="Harven Mühendislik" />
                        <span class="verified-tag">@L["Partners.TagTechnical"]</span>
                    </div>
                    <h3 style="font-size:1.15rem; margin-bottom:8px;">Harven Mühendislik</h3>
                    <p style="font-size:0.9rem; color:#475569; line-height:1.5; margin-bottom:20px;">Otonom sistemler ve robotik teknolojilerinde modüler tasarım ve donanım bağımsız mimari üzerine teknik danışmanlık ve destek mektubu.</p>
                    <a class="btn btn-primary btn-sm" style="width:100%; text-align:center; justify-content:center;" href="/docs/destek-mektubu-harven.pdf" target="_blank" rel="noopener noreferrer">@L["Partners.ViewSupportLetter"]</a>
                </div>
                <div class="support-letter-card">
                    <div class="support-card-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                        <img src="~/img/partners/uludogan-logo.png" style="height:44px; width:auto; object-fit:contain;" alt="Uludoğan Savunma" />
                        <span class="verified-tag">@L["Partners.TagDefense"]</span>
                    </div>
                    <h3 style="font-size:1.15rem; margin-bottom:8px;">Uludoğan Savunma</h3>
                    <p style="font-size:0.9rem; color:#475569; line-height:1.5; margin-bottom:20px;">TRL 6 - TRL 8 entegrasyonu, gerçek zamanlı risk analizi, pilot test ev sahipliği ve ticari satın alma niyet mektubu.</p>
                    <a class="btn btn-primary btn-sm" style="width:100%; text-align:center; justify-content:center;" href="/docs/destek-mektubu-uludogan.pdf" target="_blank" rel="noopener noreferrer">@L["Partners.ViewSupportLetter"]</a>
                </div>
                <div class="support-letter-card">
                    <div class="support-card-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                        <img src="~/img/partners/erzincan-tso-logo.png" style="height:44px; width:auto; object-fit:contain;" alt="Erzincan TSO" />
                        <span class="verified-tag">@L["Partners.TagChamber"]</span>
                    </div>
                    <h3 style="font-size:1.15rem; margin-bottom:8px;">Erzincan Ticaret ve Sanayi Odası</h3>
                    <p style="font-size:0.9rem; color:#475569; line-height:1.5; margin-bottom:20px;">12 Mart 2026 tarihli 113 sayılı Yönetim Kurulu Kararı ile onaylanan resmi oda destek ve inovasyon yazısı.</p>
                    <a class="btn btn-primary btn-sm" style="width:100%; text-align:center; justify-content:center;" href="/docs/destek-mektubu-erzincan-tso.pdf" target="_blank" rel="noopener noreferrer">@L["Partners.ViewSupportLetter"]</a>
                </div>
                <div class="support-letter-card">
                    <div class="support-card-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                        <img src="~/img/partners/ebyu-logo.png" style="height:44px; width:auto; object-fit:contain;" alt="EBYÜ" />
                        <span class="verified-tag">@L["Partners.TagAcademic"]</span>
                    </div>
                    <h3 style="font-size:1.15rem; margin-bottom:8px;">Erzincan Binali Yıldırım Üniversitesi</h3>
                    <p style="font-size:0.9rem; color:#475569; line-height:1.5; margin-bottom:20px;">Mühendislik-Mimarlık Fakültesi Dekanlığı tarafından sunulan siber güvenlik ve akademik araştırma destek mektubu.</p>
                    <a class="btn btn-primary btn-sm" style="width:100%; text-align:center; justify-content:center;" href="/docs/destek-mektubu-ebyu.pdf" target="_blank" rel="noopener noreferrer">@L["Partners.ViewSupportLetter"]</a>
                </div>
                <div class="support-letter-card">
                    <div class="support-card-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                        <img src="~/img/partners/sanayi-il-mudurlugu-logo.svg" style="height:42px; width:auto; object-fit:contain;" alt="T.C. Sanayi Bakanlığı" />
                        <span class="verified-tag">@L["Partners.TagPublic"]</span>
                    </div>
                    <h3 style="font-size:1.15rem; margin-bottom:8px;">T.C. Sanayi ve Teknoloji İl Müdürlüğü</h3>
                    <p style="font-size:0.9rem; color:#475569; line-height:1.5; margin-bottom:20px;">Milli Teknoloji Hamlesi ve yerli otonom yazılım ekosisteminin geliştirilmesine yönelik T.C. Bakanlık İl Müdürlüğü destek yazısı.</p>
                    <a class="btn btn-primary btn-sm" style="width:100%; text-align:center; justify-content:center;" href="/docs/destek-mektubu-sanayi-il-mudurlugu.pdf" target="_blank" rel="noopener noreferrer">@L["Partners.ViewSupportLetter"]</a>
                </div>
            </div>
        </div>

        @if (Model.OtherPartners.Count > 0)
        {
            <div class="section-head section-head--tight" data-reveal>
                <h2>@L["Partners.OthersHeading"]</h2>
            </div>
            <div class="partner-grid">
                @foreach (var partner in Model.OtherPartners)
                {
                    <article class="partner-card" data-reveal>
                        @if (!string.IsNullOrWhiteSpace(partner.LogoUrl))
                        {
                            <img class="partner-logo" src="@partner.LogoUrl" width="56" height="56" loading="lazy" decoding="async" alt="@L["Partners.LogoAlt", partner.Name]" />
                        }
                        else
                        {
                            <span class="partner-logo" aria-hidden="true">@Initials(partner.Name)</span>
                        }
                        <div>
                            <h3 style="margin:0 0 6px;">@partner.Name</h3>
                            @if (!string.IsNullOrWhiteSpace(partner.Description))
                            {
                                <p class="muted mb-0">@partner.Description</p>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
