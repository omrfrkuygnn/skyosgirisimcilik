@{
    ViewData["Title"] = null;
    ViewData["BodyClass"] = "page-home";
    ViewData["Description"] = L["Home.Description"];
}

<section class="hero-slider" data-hero-slider data-slide-label="@L["Home.SlideLabel"]" aria-roledescription="carousel" aria-label="@L["Home.CarouselLabel"]">
    <div class="hero-slides">
        <article class="hero-slide is-active" data-slide aria-hidden="false">
            <img class="hero-slide-bg" src="~/img/banners/banner-platform.webp" width="1920" height="1080" alt="" decoding="async" asp-append-version="true" />
            <div class="hero-slide-shade hero-slide-shade--skyos" aria-hidden="true"></div>
            <div class="hero-slide-content">
                <p class="hero-kicker">@L["Home.Hero1Kicker"]</p>
                <p class="hero-brand">Sky<span>OS</span></p>
                <h1>@L["Home.Hero1Title"]</h1>
                <p class="hero-sub">@L["Home.Hero1Sub"]</p>
                <div class="hero-actions">
                    <a class="btn btn-primary" href="@SiteUrls.Page(SitePageKeys.Contact)">@L["Home.Hero1CtaPrimary"]</a>
                    <a class="btn btn-ghost-light" href="@SiteUrls.Page(SitePageKeys.Product)">@L["Home.Hero1CtaSecondary"]</a>
                </div>
            </div>
        </article>

        <article class="hero-slide" data-slide aria-hidden="true">
            <img class="hero-slide-bg" src="~/img/banners/banner-swarm.webp" width="1920" height="1080" alt="" loading="lazy" decoding="async" asp-append-version="true" />
            <div class="hero-slide-shade hero-slide-shade--teknofest" aria-hidden="true"></div>
            <div class="hero-slide-content">
                <p class="hero-kicker">@L["Home.Hero2Kicker"]</p>
                <h2 class="hero-slide-title">@L["Home.Hero2Title"]</h2>
                <p class="hero-sub">@L["Home.Hero2Sub"]</p>
                <div class="hero-actions">
                    <a class="btn btn-primary" href="@SiteUrls.Page(SitePageKeys.Achievements)">@L["Home.Hero2CtaPrimary"]</a>
                    <a class="btn btn-ghost-light" href="@SiteUrls.Page(SitePageKeys.UseCases)">@L["Home.Hero2CtaSecondary"]</a>
                </div>
            </div>
        </article>

        <article class="hero-slide" data-slide aria-hidden="true">
            <img class="hero-slide-bg" src="~/img/banners/banner-combat.webp" width="1920" height="1080" alt="" loading="lazy" decoding="async" asp-append-version="true" />
            <div class="hero-slide-shade hero-slide-shade--combat" aria-hidden="true"></div>
            <div class="hero-slide-content">
                <p class="hero-kicker">@L["Home.Hero3Kicker"]</p>
                <h2 class="hero-slide-title">@L["Home.Hero3Title"]</h2>
                <p class="hero-sub">@L["Home.Hero3Sub"]</p>
                <div class="hero-actions">
                    <a class="btn btn-primary" href="@SiteUrls.Page(SitePageKeys.Product)">@L["Home.Hero3CtaPrimary"]</a>
                    <a class="btn btn-ghost-light" href="@SiteUrls.Page(SitePageKeys.Achievements)">@L["Home.Hero3CtaSecondary"]</a>
                </div>
            </div>
        </article>

        <article class="hero-slide" data-slide aria-hidden="true">
            <img class="hero-slide-bg" src="~/img/banners/banner-corporate.webp" width="1920" height="1080" alt="" loading="lazy" decoding="async" asp-append-version="true" />
            <div class="hero-slide-shade hero-slide-shade--havelsan" aria-hidden="true"></div>
            <div class="hero-slide-content">
                <p class="hero-kicker">@L["Home.Hero4Kicker"]</p>
                <h2 class="hero-slide-title">@L["Home.Hero4Title"]</h2>
                <p class="hero-sub">@L["Home.Hero4Sub"]</p>
                <div class="hero-actions">
                    <a class="btn btn-primary" href="@SiteUrls.Page(SitePageKeys.Partners)">@L["Home.Hero4CtaPrimary"]</a>
                    <a class="btn btn-ghost-light" href="@SiteUrls.Page(SitePageKeys.Investors)">@L["Home.Hero4CtaSecondary"]</a>
                </div>
            </div>
        </article>
    </div>

    <div class="hero-slider-ui">
        <button type="button" class="hero-nav hero-nav-prev" data-slider-prev aria-label="@L["Home.SlidePrev"]">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 6 9 12l6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="hero-nav hero-nav-next" data-slider-next aria-label="@L["Home.SlideNext"]">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="hero-dots" data-slider-dots role="tablist" aria-label="@L["Home.SlideSelect"]"></div>
        <div class="hero-progress" aria-hidden="true"><span data-slider-progress></span></div>
    </div>
</section>

<div class="marquee-strip" aria-hidden="true" data-marquee>
    <div class="marquee-track">
        <span class="marquee-item logo-item">
            <img src="~/img/partners/havelsan.svg" class="marquee-logo marquee-logo--large" alt="HAVELSAN" asp-append-version="true" />
        </span>
        <span>@L["Home.MarqueeAirLandSea"]</span>

        <span class="marquee-item logo-item">
            <img src="~/img/partners/uludogan-logo.png" class="marquee-logo marquee-logo--large" alt="Uludoğan Savunma" asp-append-version="true" />
        </span>
        <span>@L["Home.MarqueeMemory"]</span>

        <span class="marquee-item logo-item">
            <img src="~/img/partners/erzincan-tso-logo.png" class="marquee-logo marquee-logo--large" alt="Erzincan TSO" asp-append-version="true" />
        </span>
        <span>@L["Home.MarqueeHotSwap"]</span>

        <span class="marquee-item logo-item">
            <img src="~/img/partners/ebyu-logo.png" class="marquee-logo marquee-logo--large" alt="EBYÜ" asp-append-version="true" />
        </span>
        <span>@L["Home.MarqueeSwarm"]</span>

        <span class="marquee-item logo-item">
            <img src="~/img/partners/sanayi-il-mudurlugu-logo.svg" class="marquee-logo marquee-logo--large" alt="T.C. Sanayi Bakanlığı" asp-append-version="true" />
        </span>

        <span class="marquee-item logo-item">
            <img src="~/img/partners/harven-logo.png" class="marquee-logo marquee-logo--large" alt="Harven Mühendislik" asp-append-version="true" />
        </span>

        <span class="marquee-item logo-item">
            <img src="~/img/partners/teknofest.png" class="marquee-logo marquee-logo--large" alt="TEKNOFEST" asp-append-version="true" />
        </span>

        <!-- Loop round 2 -->
        <span class="marquee-item logo-item">
            <img src="~/img/partners/havelsan.svg" class="marquee-logo marquee-logo--large" alt="HAVELSAN" asp-append-version="true" />
        </span>
        <span>@L["Home.MarqueeAirLandSea"]</span>

        <span class="marquee-item logo-item">
            <img src="~/img/partners/uludogan-logo.png" class="marquee-logo marquee-logo--large" alt="Uludoğan Savunma" asp-append-version="true" />
        </span>
        <span>@L["Home.MarqueeMemory"]</span>

        <span class="marquee-item logo-item">
            <img src="~/img/partners/erzincan-tso-logo.png" class="marquee-logo marquee-logo--large" alt="Erzincan TSO" asp-append-version="true" />
        </span>
        <span>@L["Home.MarqueeHotSwap"]</span>

        <span class="marquee-item logo-item">
            <img src="~/img/partners/ebyu-logo.png" class="marquee-logo marquee-logo--large" alt="EBYÜ" asp-append-version="true" />
        </span>
        <span>@L["Home.MarqueeSwarm"]</span>

        <span class="marquee-item logo-item">
            <img src="~/img/partners/sanayi-il-mudurlugu-logo.svg" class="marquee-logo marquee-logo--large" alt="T.C. Sanayi Bakanlığı" asp-append-version="true" />
        </span>

        <span class="marquee-item logo-item">
            <img src="~/img/partners/harven-logo.png" class="marquee-logo marquee-logo--large" alt="Harven Mühendislik" asp-append-version="true" />
        </span>

        <span class="marquee-item logo-item">
            <img src="~/img/partners/teknofest.png" class="marquee-logo marquee-logo--large" alt="TEKNOFEST" asp-append-version="true" />
        </span>
    </div>
</div>

<section class="section-tight">
    <div class="container">
        <div class="logo-wall" data-reveal>
            <div class="logo-wall-label">@L["Home.LogoWallLabel"]</div>
            <div class="logo-wall-row logo-wall-row--wrap">
                <a class="logo-chip" href="@SiteUrls.Page(SitePageKeys.Partners)" aria-label="HAVELSAN">
                    <img src="~/img/partners/havelsan.svg" width="220" height="64" alt="HAVELSAN" loading="lazy" asp-append-version="true" />
                </a>
                <a class="logo-chip" href="@SiteUrls.Page(SitePageKeys.Partners)" aria-label="Uludoğan Savunma">
                    <img src="~/img/partners/uludogan-logo.png" width="200" height="64" alt="Uludoğan Savunma" loading="lazy" asp-append-version="true" />
                </a>
                <a class="logo-chip" href="@SiteUrls.Page(SitePageKeys.Partners)" aria-label="Erzincan TSO">
                    <img src="~/img/partners/erzincan-tso-logo.png" width="180" height="64" alt="Erzincan TSO" loading="lazy" asp-append-version="true" />
                </a>
                <a class="logo-chip" href="@SiteUrls.Page(SitePageKeys.Partners)" aria-label="Erzincan Binali Yıldırım Üniversitesi">
                    <img src="~/img/partners/ebyu-logo.png" width="180" height="64" alt="EBYÜ" loading="lazy" asp-append-version="true" />
                </a>
                <a class="logo-chip" href="@SiteUrls.Page(SitePageKeys.Partners)" aria-label="T.C. Sanayi ve Teknoloji İl Müdürlüğü">
                    <img src="~/img/partners/sanayi-il-mudurlugu-logo.svg" width="220" height="64" alt="T.C. Sanayi Bakanlığı" loading="lazy" asp-append-version="true" />
                </a>
                <a class="logo-chip" href="@SiteUrls.Page(SitePageKeys.Partners)" aria-label="Harven Mühendislik">
                    <img src="~/img/partners/harven-logo.png" width="180" height="64" alt="Harven Mühendislik" loading="lazy" asp-append-version="true" />
                </a>
                <a class="logo-chip logo-chip-dark" href="@SiteUrls.Page(SitePageKeys.Achievements)" aria-label="TEKNOFEST">
                    <img src="~/img/partners/teknofest.png" width="180" height="120" alt="TEKNOFEST" loading="lazy" asp-append-version="true" />
                </a>
            </div>
        </div>
    </div>
</section>

<section class="section-tight" style="padding-top:0;">
    <div class="container">
        <div class="stat-bar" data-reveal>
            <div class="stat">
                <div class="stat-value">4+</div>
                <div class="stat-label">@L["Home.StatYears"]</div>
            </div>
            <div class="stat">
                <div class="stat-value">15</div>
                <div class="stat-label">@L["Home.StatTeam"]</div>
            </div>
            <div class="stat">
                <div class="stat-value">HAVELSAN</div>
                <div class="stat-label">@L["Home.StatJetCube"]</div>
            </div>
            <div class="stat">
                <div class="stat-value">TEKNOFEST</div>
                <div class="stat-label">@L["Home.StatField"]</div>
            </div>
        </div>
    </div>
</section>

<section class="section" style="padding-top:24px;">
    <div class="container">
        <div class="section-head" data-reveal>
            <span class="eyebrow">@L["Home.ProofEyebrow"]</span>
            <h2>@L["Home.ProofTitle"]</h2>
            <p class="lead">@L["Home.ProofLead"]</p>
        </div>

        <div class="proof-grid">
            <article class="proof-panel" data-reveal>
                <div class="proof-panel-media">
                    <img src="~/img/banners/banner-swarm.webp" width="800" height="500" alt="@L["Home.SwarmAlt"]" loading="lazy" decoding="async" asp-append-version="true" />
                    <img class="proof-panel-logo" src="~/img/partners/teknofest.png" width="140" height="48" alt="TEKNOFEST" loading="lazy" asp-append-version="true" />
                </div>
                <div class="proof-panel-copy">
                    <h3>@L["Home.SwarmTitle"]</h3>
                    <p>@L["Home.SwarmText"]</p>
                    <div class="proof-tags">
                        <span>@L["Home.SwarmRibbon1"]</span>
                        <span>@L["Home.SwarmRibbon2"]</span>
                    </div>
                </div>
            </article>

            <article class="proof-panel" data-reveal>
                <div class="proof-panel-media">
                    <img src="~/img/banners/banner-combat.webp" width="800" height="500" alt="@L["Home.CombatAlt"]" loading="lazy" decoding="async" asp-append-version="true" />
                    <img class="proof-panel-logo" src="~/img/partners/teknofest.png" width="140" height="48" alt="TEKNOFEST" loading="lazy" asp-append-version="true" />
                </div>
                <div class="proof-panel-copy">
                    <h3>@L["Home.CombatTitle"]</h3>
                    <p>@L["Home.CombatText"]</p>
                    <div class="proof-tags">
                        <span>@L["Home.CombatRibbon1"]</span>
                        <span>@L["Home.CombatRibbon2"]</span>
                    </div>
                </div>
            </article>
        </div>

        <article class="proof-partner" data-reveal>
            <div class="proof-partner-brand">
                <span class="proof-partner-tag">@L["Home.HavelsanTag"]</span>
                <img src="~/img/partners/havelsan.svg" width="220" height="64" alt="HAVELSAN" loading="lazy" asp-append-version="true" />
            </div>
            <div class="proof-partner-copy">
                <h2>@L["Home.HavelsanTitle"]</h2>
                <p>@L["Home.HavelsanText"]</p>
            </div>
            <div class="proof-partner-actions">
                <a class="btn btn-primary" href="@SiteUrls.Page(SitePageKeys.Achievements)">@L["Home.HavelsanCtaPrimary"]</a>
                <a class="btn btn-ghost" href="@SiteUrls.Page(SitePageKeys.Partners)">@L["Home.HavelsanCtaSecondary"]</a>
            </div>
        </article>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <div class="section-head" data-reveal>
            <span class="eyebrow">@L["Home.FeaturesEyebrow"]</span>
            <h2>@L["Home.FeaturesTitle"]</h2>
            <p class="lead">@L["Home.FeaturesLead"]</p>
        </div>
        <div class="cards cards-4">
            <article class="card" data-reveal>
                <div class="feature-index">01 / 04</div>
                <span class="card-icon" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 2 4 5v6c0 5 3.4 8.3 8 11 4.6-2.7 8-6 8-11V5l-8-3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <h3>@L["Home.Feature1Title"]</h3>
                <p>@L["Home.Feature1Text"]</p>
            </article>
            <article class="card" data-reveal>
                <div class="feature-index">02 / 04</div>
                <span class="card-icon" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 8h11l-2.5-2.5M20 16H9l2.5 2.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <h3>@L["Home.Feature2Title"]</h3>
                <p>@L["Home.Feature2Text"]</p>
            </article>
            <article class="card" data-reveal>
                <div class="feature-index">03 / 04</div>
                <span class="card-icon" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="6" cy="6" r="2.4" stroke="currentColor" stroke-width="1.6"/><circle cx="18" cy="6" r="2.4" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="18" r="2.4" stroke="currentColor" stroke-width="1.6"/><path d="M7.7 7.7 11 15m5.3-7.3L13 15" stroke="currentColor" stroke-width="1.6"/></svg>
                </span>
                <h3>@L["Home.Feature3Title"]</h3>
                <p>@L["Home.Feature3Text"]</p>
            </article>
            <article class="card" data-reveal>
                <div class="feature-index">04 / 04</div>
                <span class="card-icon" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="5" y="5" width="14" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M9 9h6v6H9zM12 2v3M12 19v3M2 12h3M19 12h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </span>
                <h3>@L["Home.Feature4Title"]</h3>
                <p>@L["Home.Feature4Text"]</p>
            </article>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-head mb-0" data-reveal="left">
            <span class="eyebrow">@L["Home.WhyEyebrow"]</span>
            <h2>@L["Home.WhyTitle"]</h2>
            <p class="lead">@L["Home.WhyLead"]</p>
            <a class="btn btn-ghost" href="@SiteUrls.Page(SitePageKeys.About)">@L["Home.WhyCta"]</a>
        </div>
    </div>
</section>
