@model IReadOnlyList<ContactMessageListItemDto>
@{
    ViewData["Title"] = L["Admin.ContactMessages"];
    var unread = Model.Count(x => !x.IsRead);
}

<header class="admin-page-header">
    <div>
        <p class="admin-page-eyebrow">@L["Admin.Inbox"]</p>
        <h1 class="admin-page-title">@L["Admin.ContactMessages"]</h1>
        <p class="admin-page-lead">@L["Admin.ContactMessagesLead"]</p>
    </div>
    <div class="admin-page-meta">
        <span class="admin-badge admin-badge--info">@Model.Count @L["Admin.Total"]</span>
        @if (unread > 0)
        {
            <span class="admin-badge admin-badge--warning">@unread @L["Admin.Unread"]</span>
        }
    </div>
</header>

<div class="admin-panel">
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>@L["Admin.ColName"]</th>
                    <th>@L["Admin.ColEmail"]</th>
                    <th>@L["Admin.ColInterest"]</th>
                    <th>@L["Admin.ColMessage"]</th>
                    <th>@L["Admin.ColDate"]</th>
                    <th>@L["Admin.ColStatus"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="7" class="admin-table-empty">@L["Admin.NoRecords"]</td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr class="@(item.IsRead ? "" : "is-unread")">
                    <td><strong>@item.FullName</strong></td>
                    <td><a class="admin-link" href="mailto:@item.Email">@item.Email</a></td>
                    <td><span class="admin-tag">@L.InterestLabel(item.InterestType)</span></td>
                    <td class="admin-table-message">@item.MessagePreview</td>
                    <td>@item.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                    <td>
                        <span class="admin-badge admin-badge--@(item.IsRead ? "success" : "warning")">
                            @(item.IsRead ? L["Admin.Read"] : L["Admin.Unread"])
                        </span>
                    </td>
                    <td><a class="admin-btn admin-btn-ghost admin-btn-sm" href="/ContactMessages/Details/@item.Id">@L["Admin.View"]</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
