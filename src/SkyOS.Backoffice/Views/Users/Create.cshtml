@model AdminUserCreateViewModel
@{
    ViewData["Title"] = L["Admin.AddUser"];
}

<header class="admin-page-header">
    <div>
        <p class="admin-page-eyebrow">@L["Admin.System"]</p>
        <h1 class="admin-page-title">@L["Admin.AddUser"]</h1>
        <p class="admin-page-lead">@L["Admin.UsersLead"]</p>
    </div>
    <a class="admin-btn admin-btn-ghost" href="/Users">@L["Admin.Back"]</a>
</header>

<form asp-action="Create" method="post" class="admin-cms-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="admin-validation-summary"></div>

    <div class="admin-cms-layout">
        <div class="admin-cms-main">
            <section class="admin-cms-card">
                <h2 class="admin-cms-card-title">@L["Admin.SectionBasicInfo"]</h2>
                <div class="admin-cms-grid">
                    <div class="admin-field">
                        <label asp-for="DisplayName">@L["Admin.ColName"]</label>
                        <input asp-for="DisplayName" class="admin-input" required placeholder="@L["Admin.Placeholder.UserFullName"]" />
                        <span asp-validation-for="DisplayName" class="text-danger"></span>
                    </div>
                    <div class="admin-field">
                        <label asp-for="Email">@L["Admin.ColEmail"]</label>
                        <input asp-for="Email" class="admin-input" type="email" required placeholder="@L["Admin.Placeholder.UserEmail"]" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>
            </section>

            <section class="admin-cms-card">
                <h2 class="admin-cms-card-title">@L["Admin.Password"]</h2>
                <div class="admin-cms-grid">
                    <div class="admin-field">
                        <label asp-for="Password">@L["Admin.Password"]</label>
                        <input asp-for="Password" class="admin-input" type="password" required autocomplete="new-password" />
                        <small class="admin-field-hint">@L["Admin.PasswordHint"]</small>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="admin-field">
                        <label asp-for="ConfirmPassword">@L["Admin.ConfirmPassword"]</label>
                        <input asp-for="ConfirmPassword" class="admin-input" type="password" required autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>
            </section>
        </div>

        <aside class="admin-cms-aside">
            <section class="admin-cms-card">
                <h2 class="admin-cms-card-title">@L["Admin.SectionSettings"]</h2>
                <div class="admin-settings-stack">
                    <div class="admin-field admin-field--switch">
                        <label class="admin-switch" for="IsActive">
                            <span class="admin-switch-text">@L["Admin.UserIsActive"]</span>
                            <input asp-for="IsActive" type="checkbox" id="IsActive" />
                            <span class="admin-switch-ui" aria-hidden="true"></span>
                        </label>
                    </div>
                </div>
            </section>

            <div class="admin-cms-actions">
                <button type="submit" class="admin-btn admin-btn-primary admin-btn-block">@L["Admin.Save"]</button>
                <a class="admin-btn admin-btn-ghost admin-btn-block" href="/Users">@L["Admin.Cancel"]</a>
            </div>
        </aside>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
