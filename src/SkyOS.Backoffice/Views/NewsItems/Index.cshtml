@model IReadOnlyList<NewsListItemDto>
@{
    ViewData["Title"] = L["Admin.NewsItems"];
}

<header class="admin-page-header">
    <div>
        <p class="admin-page-eyebrow">@L["Admin.ContentManagement"]</p>
        <h1 class="admin-page-title">@L["Admin.NewsItems"]</h1>
        <p class="admin-page-lead">@L["Admin.NewsItemsLead"]</p>
    </div>
    <a class="admin-btn admin-btn-primary" href="/NewsItems/Create">@L["Admin.AddNew"]</a>
</header>

<div class="admin-panel">
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>@L["Admin.ColTitle"]</th>
                    <th>@L["Admin.ColSlug"]</th>
                    <th>@L["Admin.ColDate"]</th>
                    <th>@L["Admin.ColStatus"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="admin-table-empty">@L["Admin.NoRecords"]</td></tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.Title</strong></td>
                    <td><code>@item.Slug</code></td>
                    <td>@item.PublishedAtUtc.ToLocalTime().ToString("g")</td>
                    <td>
                        <span class="admin-badge admin-badge--@(item.IsPublished ? "success" : "warning")">
                            @(item.IsPublished ? L["Admin.Published"] : L["Admin.Draft"])
                        </span>
                    </td>
                    <td class="admin-table-actions">
                        <a class="admin-btn admin-btn-ghost admin-btn-sm" href="/NewsItems/Edit/@item.Id">@L["Admin.Edit"]</a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="admin-inline-form" onsubmit="return confirm('@L["Admin.ConfirmDelete"]');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="admin-btn admin-btn-danger admin-btn-sm">@L["Admin.Delete"]</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
